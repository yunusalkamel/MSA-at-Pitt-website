{
  "headers": [
    {
      "source": "/assets/:asset*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/photos/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/owner/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/photos/recaps/banquet-for-gaza/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Discordbot|Slackbot-LinkExpanding).*"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/:path((?!api/|admin/|owner/|auth/|photos/|assets/|_vercel/)[a-z0-9-]+(?:/[a-z0-9-]+)*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Discordbot|Slackbot-LinkExpanding).*"
        }
      ],
      "destination": "/api/share?path=:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/resources",
      "destination": "/resources.html"
    },
    {
      "source": "/resources/prayer",
      "destination": "/resources/prayer.html"
    },
    {
      "source": "/resources/new-to-pitt",
      "destination": "/resources/new-to-pitt.html"
    },
    {
      "source": "/resources/chaplain",
      "destination": "/resources/chaplain.html"
    },
    {
      "source": "/resources/faq",
      "destination": "/resources/faq.html"
    },
    {
      "source": "/join",
      "destination": "/join.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/board",
      "destination": "/board.html"
    },
    {
      "source": "/((?!api/|_vercel).*)",
      "destination": "/spa.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "msaatpitt\\.vercel\\.app"
        }
      ],
      "destination": "https://msaatpitt.org/:path*",
      "permanent": true
    },
    {
      "source": "/resources/prayer-locations",
      "destination": "/resources/prayer",
      "permanent": true
    },
    {
      "source": "/resources/prayer-times",
      "destination": "/resources/prayer",
      "permanent": true
    },
    {
      "source": "/prayer-times",
      "destination": "/resources/prayer",
      "permanent": true
    }
  ]
}
